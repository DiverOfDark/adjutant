{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adjutant",
  "version": "0.1.0",
  "identifier": "dev.adjutant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adjutant",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Agentic Markdown knowledge base for managers",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNUU3QTYzQkFCRjAxRUQKUldUdEFiKzZZM3BlbWx1NlRVcmFiN0ppKzF5eVN1ZTA0NXZzZ3ZKSmtyTDZEV0x0eFBQcjFMVEcK",
      "endpoints": [
        "https://github.com/DiverOfDark/adjutant/releases/latest/download/latest.json"
      ]
    }
  }
}